# PostgreSQL (docker-compose up -d starts this locally)
DB_USER=admin
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=capstone

# Ollama (local, no API key needed — must be running: `ollama serve`)
OLLAMA_VISION_MODEL=llava
OLLAMA_EMBED_MODEL=all-minilm

# Batch job / mismatch guard tuning
CONFIDENCE_THRESHOLD=0.70
MIN_SIMILARITY_THRESHOLD=0.45

# App
PORT=3000
